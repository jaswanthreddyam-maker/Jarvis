JARVIS_ENV=development
JARVIS_DEBUG=true
JARVIS_CONSOLE_LOGGING=true
JARVIS_LOG_LEVEL=DEBUG
JARVIS_LOG_DIR=logs

JARVIS_MEMORY_DB_PATH=assistant/memory/longterm.db
JARVIS_DB_SCHEMA_PATH=assistant/memory/db_schema.sql
JARVIS_PERMISSIONS_PATH=assistant/permissions.yaml
JARVIS_RETRY_POLICY_PATH=assistant/retry_policy.yaml
JARVIS_PERSONALITY_PATH=assistant/personality.json

JARVIS_SAFE_MODE=false
JARVIS_SIMULATE_ACTIONS=false
JARVIS_OFFLINE_MODE=false

JARVIS_MAX_CONCURRENT_REQUESTS=2
JARVIS_MAX_PENDING_REQUESTS=8
JARVIS_MAX_MEMORY_MB=1024

JARVIS_RETRY_MAX_ATTEMPTS=3
JARVIS_RETRY_BACKOFF_BASE_SECONDS=0.5
JARVIS_RETRY_BACKOFF_MAX_SECONDS=8
JARVIS_RETRY_JITTER_SECONDS=0.2

JARVIS_HEALTH_ENABLED=true
JARVIS_HEALTH_HOST=127.0.0.1
JARVIS_HEALTH_PORT=8765
JARVIS_HEALTH_API_TIMEOUT_SECONDS=5
JARVIS_HEALTH_CHECK_EXTERNAL_CONNECTIVITY=false
JARVIS_HEALTH_MEMORY_WARNING_MB=512
JARVIS_HEALTH_STARTUP_GRACE_SECONDS=30
JARVIS_HEALTH_HEARTBEAT_TIMEOUT_SECONDS=10
JARVIS_HEALTH_POLL_INTERVAL_SECONDS=2
JARVIS_HEALTH_RETRY_RESET_SECONDS=60
JARVIS_HEALTH_MAX_BACKOFF_SECONDS=120

JARVIS_API_ENABLED=true
JARVIS_API_HOST=0.0.0.0
JARVIS_API_PORT=8000
JARVIS_API_REQUEST_TIMEOUT_SECONDS=30

JARVIS_PROVIDER_TIMEOUT_SECONDS=30
JARVIS_PROVIDER_MAX_TOKENS=512

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
